# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=4000

# Local MySQL. Setup steps are in README.md.
DATABASE_URL=mysql://nestwise:nestwise@localhost:3306/nestwise
# Scratch database Prisma uses to plan migrations (prisma migrate dev).
SHADOW_DATABASE_URL=mysql://nestwise:nestwise@localhost:3306/nestwise_shadow

# Refresh tokens last this many days; after that the user logs in again.
SESSION_DAYS=30
# Access tokens are short-lived and renewed with the refresh token.
ACCESS_TOKEN_MINUTES=15
